rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidTemplate(data) {
      return data.keys().hasAll(['name', 'category', 'imageUrl', 'createdAt']) &&
             data.name is string && data.name.size() <= 200 &&
             data.category in ['Islamic', 'Name', 'Wedding'] &&
             data.imageUrl is string && data.imageUrl.size() <= 2000;
    }

    function isAdmin() {
      return isSignedIn() && 
             request.auth.token.email == 'haroofcalligraphy@gmail.com';
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Templates collection
    match /templates/{templateId} {
      allow read: if true; // Publicly viewable
      allow create, update, delete: if isAdmin();
    }

    // Config collection
    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
